# ── App ──────────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Database (same Postgres instance as NestJS) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus

# ── Redis ───────────────────────────────
REDIS_URL=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small   # 1536 dims, cheap, fast
CHAT_MODEL=gpt-4o-mini                   # Used in ReAct loop

# ── AWS S3 (same bucket as NestJS) ───────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nexus-documents

# ── RAG settings ─────────────────────────────────────────────────────────────
CHUNK_SIZE=400          # Target tokens per chunk
CHUNK_OVERLAP=80        # Overlap between consecutive chunks (prevents context loss at boundaries)
RAG_TOP_K=4             # How many chunks to retrieve per query

# ── NestJS backend (for internal callbacks) ───────────────────────────────────
NESTJS_URL=http://localhost:3001
NESTJS_INTERNAL_SECRET=change_me   # Shared secret for service-to-service calls

WIDGET_JWT_SECRET=change_me_too   # Secret for signing JWTs used by the frontend widget